# Ported from arduino-examples/examples/04.Communication/ReadASCIIString/ReadASCIIString.ino, CC0
# Adapted: three potentiometers replace serial input for RGB control
DEVICE ARDUINO-UNO
CLOCK 16000000
PIN potR = A0 ANALOG
PIN potG = A1 ANALOG
PIN potB = A2 ANALOG
PIN ledR = D3 PWM
PIN ledG = D5 PWM
PIN ledB = D6 PWM

SPRITE Cat:
  WHEN flag clicked:
    forever:
      set ledR to ((read potR * 100) / 1023) percent
      set ledG to ((read potG * 100) / 1023) percent
      set ledB to ((read potB * 100) / 1023) percent
      wait 0.05 seconds
