DEVICE STC12C5A60S2
CLOCK 11059200
PIN servo = P1.1 OUTPUT
PART arm = SERVO 1

# Servo sweep: move from 0° to 180° in 10° steps, then back.
# Power comes from the SUPPLY RAIL (VCC/GND), not from the chip pin.
# The pin carries only the 50 Hz control signal (~µA, not hundreds of mA).
# This circuit must NOT trip the 120 mA chip-budget warning.
WHEN flag clicked:
  set pos to 0
  FOREVER:
    REPEAT 18:
      change pos by 10
      set arm angle to pos
      wait 0.1 seconds
    REPEAT 18:
      change pos by -10
      set arm angle to pos
      wait 0.1 seconds
