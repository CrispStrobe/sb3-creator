DEVICE STC12C5A60S2
CLOCK 11059200
PIN noise = P3.2 INPUT
PIN blip = P1.0 OUTPUT ACTIVE LOW
PIN warn = P1.1 OUTPUT ACTIVE LOW

# How noisy is the room? Count separate noises in 10-second windows.
# A noise is counted on its RISING edge (quiet -> loud), so a noise that
# lasts counts once. blip flashes for every counted noise; warn lights when a
# window held 5 or more noises, and the count goes to the serial monitor.
WHEN flag clicked:
  FOREVER:
    set count to 0
    set last to 0
    REPEAT 1000:
      set now to read noise
      IF now = 1 AND last = 0 THEN:
        change count by 1
        turn on blip
      ELSE:
        turn off blip
      set last to now
      wait 0.01 seconds
    print count
    IF count >= 5 THEN:
      turn on warn
    ELSE:
      turn off warn
