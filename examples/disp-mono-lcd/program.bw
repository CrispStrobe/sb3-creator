DEVICE STC12C5A60S2
CLOCK 11059200
PIN sda = P2.1 OUTPUT
PIN scl = P2.2 OUTPUT

GLOBAL count

STAGE:
  # Monochrome graphic LCD showcase (SSD1306 as mono_lcd).
  # Uses the same OLED verbs — the widget renders as a mono LCD face.
  WHEN flag clicked:
    oled clear 1
    oled print "MONO LCD" on 1
    oled set cursor 0 2 on 1
    oled print "128x64 pixels" on 1
    set count to 0
    FOREVER:
      oled set cursor 0 4 on 1
      oled print "Frame: " on 1
      oled print count on 1
      oled print "  " on 1
      change count by 1
      wait 1 seconds
