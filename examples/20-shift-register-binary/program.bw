DEVICE STC12C5A60S2
CLOCK 11059200
PIN data = P1.0 OUTPUT
PIN clock = P1.1 OUTPUT
PIN latch = P1.2 OUTPUT

# Count 0-255 on 8 LEDs via 74HC595 shift register
WHEN flag clicked:
  set counter to 0
  FOREVER:
    set val to counter
    REPEAT 8:
      IF (val bitand 128) > 0 THEN:
        turn on data
      ELSE:
        turn off data
      turn on clock
      turn off clock
      set val to (val shiftleft 1) bitand 255
    turn on latch
    turn off latch
    change counter by 1
    IF counter > 255 THEN:
      set counter to 0
    wait 0.25 seconds
