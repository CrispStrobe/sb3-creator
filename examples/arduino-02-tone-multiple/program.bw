# Ported from arduino-examples/examples/02.Digital/toneMultiple/toneMultiple.ino, CC0
DEVICE ARDUINO-UNO
CLOCK 16000000
PIN spk1 = D6 TONE
PIN spk2 = D7 TONE
PIN spk3 = D8 TONE

SPRITE Cat:
  WHEN flag clicked:
    forever:
      set spk1 to 440 hz
      wait 0.2 seconds
      set spk1 to 0 hz
      set spk2 to 523 hz
      wait 0.5 seconds
      set spk2 to 0 hz
      set spk3 to 659 hz
      wait 0.3 seconds
      set spk3 to 0 hz
