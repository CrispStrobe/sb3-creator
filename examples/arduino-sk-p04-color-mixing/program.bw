# Ported from arduino-examples/examples/10.StarterKit_BasicKit/p04_ColorMixingLamp, CC0
DEVICE ARDUINO-UNO
CLOCK 16000000
PIN sensorR = A0 ANALOG
PIN sensorG = A1 ANALOG
PIN sensorB = A2 ANALOG
PIN ledR = D3 PWM
PIN ledG = D5 PWM
PIN ledB = D6 PWM

SPRITE Cat:
  WHEN flag clicked:
    forever:
      set ledR to ((read sensorR * 100) / 1023) percent
      set ledG to ((read sensorG * 100) / 1023) percent
      set ledB to ((read sensorB * 100) / 1023) percent
      wait 0.05 seconds
