# Ported from arduino-examples/examples/07.Display/barGraph/barGraph.ino, CC0
DEVICE ARDUINO-UNO
CLOCK 16000000
PIN pot = A0 ANALOG
PIN led2 = D2 OUTPUT
PIN led3 = D3 OUTPUT
PIN led4 = D4 OUTPUT
PIN led5 = D5 OUTPUT
PIN led6 = D6 OUTPUT

WHEN flag clicked:
  FOREVER:
    set level to ((read pot * 5) / 1023)
    IF level >= 1 THEN:
      turn on led2
    ELSE:
      turn off led2
    IF level >= 2 THEN:
      turn on led3
    ELSE:
      turn off led3
    IF level >= 3 THEN:
      turn on led4
    ELSE:
      turn off led4
    IF level >= 4 THEN:
      turn on led5
    ELSE:
      turn off led5
    IF level >= 5 THEN:
      turn on led6
    ELSE:
      turn off led6
    wait 0.05 seconds
