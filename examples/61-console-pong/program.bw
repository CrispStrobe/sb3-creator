        turn on bus0
      IF bx = 1 THEN:
        turn on bus1
      IF bx = 2 THEN:
        turn on bus2
      IF bx = 3 THEN:
        turn on bus3
      IF bx = 4 THEN:
        turn on bus4
      IF bx = 5 THEN:
        turn on bus5
      IF bx = 6 THEN:
        turn on bus6
      IF bx = 7 THEN:
        turn on bus7
    turn on ucol3
    wait 0.001 seconds
