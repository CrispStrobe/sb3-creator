        turn on bus0
      IF bx = 1 THEN:
        turn on bus1
      IF bx = 2 THEN:
        turn on bus2
      IF bx = 3 THEN:
        turn on bus3
      IF bx = 4 THEN:
        turn on bus4
      IF bx = 5 THEN:
        turn on bus5
      IF bx = 6 THEN:
        turn on bus6
      IF bx = 7 THEN:
        turn on bus7
    turn on ucol2
    wait 0.001 seconds
    turn off ucol2
    turn off bus0
    turn off bus1
    turn off bus2
    turn off bus3
    turn off bus4
    turn off bus5
    turn off bus6
    turn off bus7
    # scan line y=3
    IF by = 3 THEN:
