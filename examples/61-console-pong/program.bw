# Ball & Paddle for the RBS15667 console — OUR OWN game, clean-room.
# 8 wide (shared bus) x 16 tall (column selects). One WHEN owns the
# scan bus (matrix rows + the score digit interleaved — they are the
# SAME wires); the other WHEN owns game state. Buttons S2/S3 move the
# paddle; a miss resets. Flashes onto the real kit unchanged.
DEVICE STC15F2K60S2
CLOCK 11059200
PIN bus0 = P1.5 OUTPUT
PIN bus1 = P4.1 OUTPUT
PIN bus2 = P2.4 OUTPUT
PIN bus3 = P2.2 OUTPUT
PIN bus4 = P2.1 OUTPUT
PIN bus5 = P2.0 OUTPUT
PIN bus6 = P4.4 OUTPUT
PIN bus7 = P1.4 OUTPUT
PIN ucol0 = P4.5 OUTPUT
PIN ucol1 = P2.7 OUTPUT
PIN ucol2 = P2.6 OUTPUT
PIN ucol3 = P0.0 OUTPUT
PIN ucol4 = P0.1 OUTPUT
PIN ucol5 = P0.2 OUTPUT
PIN ucol6 = P0.3 OUTPUT
PIN ucol7 = P0.4 OUTPUT
PIN lcol0 = P0.7 OUTPUT
PIN lcol1 = P0.6 OUTPUT
PIN lcol2 = P0.5 OUTPUT
PIN lcol3 = P1.0 OUTPUT
PIN lcol4 = P1.1 OUTPUT
PIN lcol5 = P1.6 OUTPUT
PIN lcol6 = P1.2 OUTPUT
PIN lcol7 = P1.3 OUTPUT
PIN dig1 = P2.3 OUTPUT ACTIVE LOW
PIN btnL = P3.2 INPUT ACTIVE LOW
PIN btnR = P3.3 INPUT ACTIVE LOW
PIN buzzer = P5.5 OUTPUT ACTIVE LOW

WHEN flag clicked:
  FOREVER:
    # scan line y=0
    IF by = 0 THEN:
      IF bx = 0 THEN:
        turn on bus0
      IF bx = 1 THEN:
        turn on bus1
      IF bx = 2 THEN:
        turn on bus2
      IF bx = 3 THEN:
        turn on bus3
      IF bx = 4 THEN:
        turn on bus4
      IF bx = 5 THEN:
        turn on bus5
      IF bx = 6 THEN:
        turn on bus6
      IF bx = 7 THEN:
        turn on bus7
    turn on ucol0
    wait 0.001 seconds
    turn off ucol0
    turn off bus0
    turn off bus1
    turn off bus2
    turn off bus3
    turn off bus4
    turn off bus5
    turn off bus6
    turn off bus7
    # scan line y=1
    IF by = 1 THEN:
      IF bx = 0 THEN:
        turn on bus0
      IF bx = 1 THEN:
        turn on bus1
      IF bx = 2 THEN:
        turn on bus2
      IF bx = 3 THEN:
        turn on bus3
      IF bx = 4 THEN:
        turn on bus4
      IF bx = 5 THEN:
        turn on bus5
      IF bx = 6 THEN:
        turn on bus6
      IF bx = 7 THEN:
        turn on bus7
    turn on ucol1
    wait 0.001 seconds
    turn off ucol1
    turn off bus0
    turn off bus1
    turn off bus2
    turn off bus3
    turn off bus4
    turn off bus5
    turn off bus6
    turn off bus7
    # scan line y=2
    IF by = 2 THEN:
