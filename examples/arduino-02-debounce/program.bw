# Ported from arduino-examples/examples/02.Digital/Debounce/Debounce.ino, CC0
DEVICE ARDUINO-UNO
CLOCK 16000000
PIN btn = D2 INPUT
PIN led = D13 OUTPUT

SPRITE Cat:
  WHEN flag clicked:
    set ledState to 1
    set lastReading to 0
    set lastDebounceTime to 0
    set debounceDelay to 50
    turn on led
    forever:
      set reading to read btn
      if reading != lastReading then:
        set lastDebounceTime to (timer * 1000)
      if (timer * 1000) - lastDebounceTime > debounceDelay then:
        if reading != buttonState then:
          set buttonState to reading
          if buttonState = 1 then:
            if ledState = 1 then:
              set ledState to 0
              turn off led
            else:
              set ledState to 1
              turn on led
      set lastReading to reading
