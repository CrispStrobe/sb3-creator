# Ported from arduino-examples/examples/05.Control/Arrays/Arrays.ino, CC0
DEVICE ARDUINO-UNO
CLOCK 16000000
PIN led2 = D2 OUTPUT
PIN led3 = D3 OUTPUT
PIN led4 = D4 OUTPUT
PIN led5 = D5 OUTPUT
PIN led6 = D6 OUTPUT
PIN led7 = D7 OUTPUT

SPRITE Cat:
  WHEN flag clicked:
    LIST ledPins
    add D2 to ledPins
    add D7 to ledPins
    add D4 to ledPins
    add D6 to ledPins
    add D5 to ledPins
    add D3 to ledPins
    forever:
      # Forward
      repeat 6:
        turn on led2
        wait 0.1 seconds
        turn off led2
      # Reverse
      repeat 6:
        turn on led7
        wait 0.1 seconds
        turn off led7
