# Ported from arduino-examples/examples/10.StarterKit_BasicKit/p08_DigitalHourglass, CC0
DEVICE ARDUINO-UNO
CLOCK 16000000
PIN led2 = D2 OUTPUT
PIN led3 = D3 OUTPUT
PIN led4 = D4 OUTPUT
PIN led5 = D5 OUTPUT
PIN led6 = D6 OUTPUT
PIN led7 = D7 OUTPUT
PIN tilt = D8 INPUT

SPRITE Cat:
  WHEN flag clicked:
    set currentLed to 0
    set interval to 10
    forever:
      if currentLed >= 1 then: turn on led2
      if currentLed >= 2 then: turn on led3
      if currentLed >= 3 then: turn on led4
      if currentLed >= 4 then: turn on led5
      if currentLed >= 5 then: turn on led6
      if currentLed >= 6 then: turn on led7
      wait interval seconds
      if currentLed < 6 then:
        change currentLed by 1
      # Tilt switch resets
      if read tilt then:
        set currentLed to 0
        turn off led2
        turn off led3
        turn off led4
        turn off led5
        turn off led6
        turn off led7
