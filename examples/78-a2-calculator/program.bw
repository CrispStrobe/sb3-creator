# The A2 calculator: a chain calculator on the Prechin A2's own
# hardware vocabulary — eight 7-segment digits (two 4-digit tubes,
# segments shared on P0, one common per digit on P2), the 4x4 red
# keypad on P1 (rows driven low, columns read back — the measured
# A2 map), and the four black keys on P3 as memory/edit keys.
#
# The silk-screen is unusual. In row-major scan order it reads:
#   3 7 B F / 2 6 A E / 1 5 9 D / 0 4 8 C
# A/B/C/D are +,-,x,/; E clears entry; F equals.
# Black keys: K1 clear all, K2 backspace, K3 M+, K4 MR.
#
# SEVENSEG8 owns the 74HC245/74HC138 refresh in the timer ISR.
DEVICE STC89C52RC
CLOCK 11059200

PART display = SEVENSEG8 SEGMENTS P0 SELECT P2.2 P2.3 P2.4

PIN row0 = P1.7 OUTPUT ACTIVE LOW
PIN row1 = P1.6 OUTPUT ACTIVE LOW
PIN row2 = P1.5 OUTPUT ACTIVE LOW
PIN row3 = P1.4 OUTPUT ACTIVE LOW
PIN col0 = P1.3 INPUT ACTIVE LOW
PIN col1 = P1.2 INPUT ACTIVE LOW
PIN col2 = P1.1 INPUT ACTIVE LOW
PIN col3 = P1.0 INPUT ACTIVE LOW

PIN k1 = P3.1 INPUT ACTIVE LOW
PIN k2 = P3.0 INPUT ACTIVE LOW
PIN k3 = P3.2 INPUT ACTIVE LOW
PIN k4 = P3.3 INPUT ACTIVE LOW

DEFINE read_cols:
  set hit to 0 - 1
  IF read col0 THEN:
    set hit to 0
  IF read col1 THEN:
    set hit to 1
  IF read col2 THEN:
    set hit to 2
  IF read col3 THEN:
    set hit to 3

DEFINE scan_keypad:
  set key to 0 - 1
  turn on row0
  read_cols
  turn off row0
  IF hit >= 0 THEN:
    set key to hit
  turn on row1
  read_cols
  turn off row1
  IF hit >= 0 AND key < 0 THEN:
    set key to 4 + hit
  turn on row2
  read_cols
  turn off row2
  IF hit >= 0 AND key < 0 THEN:
    set key to 8 + hit
  turn on row3
  read_cols
  turn off row3
  IF hit >= 0 AND key < 0 THEN:
    set key to 12 + hit

DEFINE apply_pending:
  IF op = 1 THEN:
    set acc to acc + entry
  IF op = 2 THEN:
    set acc to acc - entry
  IF op = 3 THEN:
    set acc to acc * entry
  IF op = 4 THEN:
    IF entry = 0 THEN:
      set acc to 0
    ELSE:
      set acc to acc / entry
  IF acc < 0 THEN:
    set acc to 0
  IF acc > 32767 THEN:
    set acc to 32767

DEFINE press_digit:
  IF fresh = 1 THEN:
    set entry to digit
    set fresh to 0
  ELSE:
    IF entry < 3276 THEN:
      set entry to entry * 10 + digit
    ELSE:
      IF entry = 3276 AND digit < 8 THEN:
        set entry to entry * 10 + digit
  set shown to entry

DEFINE press_op:
  IF fresh = 0 THEN:
    IF op = 0 THEN:
      set acc to entry
    ELSE:
      apply_pending
  set op to newop
  set fresh to 1
  set shown to acc

WHEN flag clicked:
  set acc to 0
  set entry to 0
  set op to 0
  set fresh to 1
  set mem to 0
  set lastkey to 0 - 1
  FOREVER:
    scan_keypad
    IF key >= 0 AND not key = lastkey THEN:
      IF key = 0 THEN:
        set digit to 3
        press_digit
      IF key = 1 THEN:
        set digit to 7
        press_digit
      IF key = 2 THEN:
        set newop to 2
        press_op
      IF key = 4 THEN:
        set digit to 2
        press_digit
      IF key = 5 THEN:
        set digit to 6
        press_digit
      IF key = 6 THEN:
        set newop to 1
        press_op
      IF key = 8 THEN:
        set digit to 1
        press_digit
      IF key = 9 THEN:
        set digit to 5
        press_digit
      IF key = 10 THEN:
        set digit to 9
        press_digit
      IF key = 12 THEN:
        set digit to 0
        press_digit
      IF key = 13 THEN:
        set digit to 4
        press_digit
      IF key = 14 THEN:
        set digit to 8
        press_digit
      IF key = 11 THEN:
        set newop to 4
        press_op
      IF key = 15 THEN:
        set newop to 3
        press_op
      IF key = 3 THEN:
        IF op > 0 AND fresh = 0 THEN:
          apply_pending
          set op to 0
          set shown to acc
        set fresh to 1
      IF key = 7 THEN:
        set entry to 0
        set fresh to 1
        set shown to 0
    set lastkey to key
    IF read k1 THEN:
      set acc to 0
      set entry to 0
      set op to 0
      set fresh to 1
      set shown to 0
    IF read k2 THEN:
      set entry to (entry - entry mod 10) / 10
      set shown to entry
    IF read k3 THEN:
      set mem to mem + shown
    IF read k4 THEN:
      set entry to mem
      set fresh to 0
      set shown to mem
    show number shown on display
    wait 25 ms
