# Ported from arduino-examples/examples/10.StarterKit_BasicKit/p06_LightTheremin, CC0
DEVICE ARDUINO-UNO
CLOCK 16000000
PIN ldr = A0 ANALOG
PIN speaker = D8 OUTPUT

WHEN flag clicked:
  set sensorMin to 1023
  set sensorMax to 0
  REPEAT 100:
    set val to read ldr
    IF val > sensorMax THEN:
      set sensorMax to val
    IF val < sensorMin THEN:
      set sensorMin to val
    wait 0.05 seconds
  FOREVER:
    set val to read ldr
    IF val < sensorMin THEN:
      set val to sensorMin
    IF val > sensorMax THEN:
      set val to sensorMax
    set pitch to (200 + (((val - sensorMin) * 3800) / (sensorMax - sensorMin)))
    set tone speaker to pitch
    wait 0.02 seconds
