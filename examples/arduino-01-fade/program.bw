# Ported from arduino-examples/examples/01.Basics/Fade/Fade.ino, CC0
DEVICE ARDUINO-UNO
CLOCK 16000000
PIN led = D9 PWM

SPRITE Cat:
  WHEN flag clicked:
    set brightness to 0
    set fadeAmount to 2
    forever:
      set led to brightness percent
      change brightness by fadeAmount
      if brightness <= 0 or brightness >= 100 then:
        set fadeAmount to (0 - fadeAmount)
      wait 0.03 seconds
