# Ported from arduino-examples/examples/10.StarterKit_BasicKit/p07_Keyboard, CC0
DEVICE ARDUINO-UNO
CLOCK 16000000
PIN btn1 = D2 INPUT
PIN btn2 = D3 INPUT
PIN btn3 = D4 INPUT
PIN btn4 = D5 INPUT
PIN speaker = D8 OUTPUT

SPRITE Cat:
  WHEN flag clicked:
    forever:
      if read btn1 then:
        set tone speaker to 262
      if read btn2 then:
        set tone speaker to 294
      if read btn3 then:
        set tone speaker to 330
      if read btn4 then:
        set tone speaker to 349
      if not read btn1 and not read btn2 and not read btn3 and not read btn4 then:
        turn off speaker
      wait 0.02 seconds
