# Ported from arduino-examples/examples/10.StarterKit_BasicKit/p07_Keyboard, CC0
DEVICE ARDUINO-UNO
CLOCK 16000000
PIN btn1 = D2 INPUT
PIN btn2 = D3 INPUT
PIN btn3 = D4 INPUT
PIN btn4 = D5 INPUT
PIN speaker = D8 TONE

SPRITE Cat:
  WHEN flag clicked:
    forever:
      if read btn1 then:
        set speaker to 262 hz
      if read btn2 then:
        set speaker to 294 hz
      if read btn3 then:
        set speaker to 330 hz
      if read btn4 then:
        set speaker to 349 hz
      if not read btn1 and not read btn2 and not read btn3 and not read btn4 then:
        set speaker to 0 hz
      wait 0.02 seconds
