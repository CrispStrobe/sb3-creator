# Ported from arduino-examples/examples/05.Control/switchCase/switchCase.ino, CC0
DEVICE ARDUINO-UNO
CLOCK 16000000
PIN ldr = A0 ANALOG

SPRITE Cat:
  WHEN flag clicked:
    forever:
      set sensorReading to read ldr
      # floor of (reading / 256) is the documented 0/256/512/768 mapping and is
      # EXACT: the C target's `/` truncates and the VM's floor rounds the same way.
      # `(reading / 1024) * 3` was neither — 0 in C, and a fraction in the VM that
      # matched none of the four `range = N` branches below.
      set range to floor of (sensorReading / 256)
      if range = 0 then:
        print "dark"
      if range = 1 then:
        print "dim"
      if range = 2 then:
        print "medium"
      if range = 3 then:
        print "bright"
      wait 0.5 seconds
