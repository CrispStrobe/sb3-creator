# A Bausatz multimeter (HU-050 class), stage one: the measuring core.
# Three modes on the 3-digit display, cycled by the MODE button with a
# buzzer chirp:
#   mode 0  volts through the 30k/10k divider      -> "X.YZ" (dp lit)
#   mode 1  milliamps via 0.02R shunt + LM358 x46  -> whole mA
#   mode 2  NTC via B-equation piecewise map       -> "XY.Z" degC
#            (dp on the middle digit; sub-zero shows "-XY" whole degrees
#            with segment g as the minus sign)
DEVICE STC15F2K60S2
CLOCK 11059200
PIN sa = P0.0 OUTPUT
PIN sb = P0.1 OUTPUT
PIN sc = P0.2 OUTPUT
PIN sd = P0.3 OUTPUT
PIN se = P0.4 OUTPUT
PIN sf = P0.5 OUTPUT
PIN sg = P0.6 OUTPUT
PIN sdp = P0.7 OUTPUT
PIN dig0 = P2.0 OUTPUT ACTIVE LOW
PIN dig1 = P2.1 OUTPUT ACTIVE LOW
PIN dig2 = P2.2 OUTPUT ACTIVE LOW
PIN vin = P1.0 ANALOG
PIN ain = P1.1 ANALOG
PIN tin = P1.2 ANALOG
PIN modeBtn = P3.2 INPUT ACTIVE LOW
PIN buzz = P5.5 OUTPUT ACTIVE LOW

DEFINE FAST clear segments:
  turn off sa
  turn off sb
  turn off sc
  turn off sd
  turn off se
  turn off sf
  turn off sg
  turn off sdp

DEFINE FAST render digit (n):
  IF n = 0 THEN:
    turn on sa
    turn on sb
    turn on sc
    turn on sd
    turn on se
    turn on sf
  IF n = 1 THEN:
    turn on sb
    turn on sc
  IF n = 2 THEN:
    turn on sa
    turn on sb
    turn on sd
    turn on se
    turn on sg
  IF n = 3 THEN:
    turn on sa
    turn on sb
    turn on sc
    turn on sd
    turn on sg
  IF n = 4 THEN:
    turn on sb
    turn on sc
    turn on sf
    turn on sg
  IF n = 5 THEN:
    turn on sa
    turn on sc
    turn on sd
    turn on sf
    turn on sg
  IF n = 6 THEN:
    turn on sa
    turn on sc
    turn on sd
    turn on se
    turn on sf
    turn on sg
  IF n = 7 THEN:
    turn on sa
    turn on sb
    turn on sc
  IF n = 8 THEN:
    turn on sa
    turn on sb
    turn on sc
    turn on sd
    turn on se
    turn on sf
    turn on sg
  IF n = 9 THEN:
    turn on sa
    turn on sb
    turn on sc
    turn on sd
    turn on sf
    turn on sg
  IF n = 10 THEN:
    turn on sg

WHEN flag clicked:
  set d0 to 0
  set d1 to 0
  set d2 to 0
  set dpDig to 9
  FOREVER:
    render digit (d0)
    IF dpDig = 0 THEN:
      turn on sdp
    turn on dig0
    wait 0.002 seconds
    turn off dig0
    clear segments
    render digit (d1)
    IF dpDig = 1 THEN:
      turn on sdp
    turn on dig1
    wait 0.002 seconds
    turn off dig1
    clear segments
    render digit (d2)
    turn on dig2
    wait 0.002 seconds
    turn off dig2
    clear segments

WHEN flag clicked:
  set mode to 0
  set lastBtn to 0
  FOREVER:
    # the MODE button, edge-detected, with a chirp
    IF read modeBtn THEN:
      IF lastBtn = 0 THEN:
        change mode by 1
        IF mode > 2 THEN:
          set mode to 0
        turn on buzz
        wait 0.03 seconds
        turn off buzz
      set lastBtn to 1
    ELSE:
      set lastBtn to 0
    # take the reading for the current mode
    IF mode = 0 THEN:
      # pin sees V/4; show centivolts as X.YZ
      set mv to read vin * 5000 / 1023
      set cand to mv * 4 / 10
      set dpDig to 0
      set showMinus to 0
    IF mode = 1 THEN:
      # LM358 output = shunt mV x 46.5; I = shunt mV x 50
      set mv to read ain * 5000 / 1023
      set cand to mv * 50 / 47
      set dpDig to 9
      set showMinus to 0
    IF mode = 2 THEN:
      # NTC B-equation (B=3950, 10k at 25C, 10k to GND) as a piecewise
      # linear map over the divider millivolts; t10 = deci-degC. The
      # anchors are monotonic in mv, so each IF simply overwrites the
      # previous segment - the last match wins, no ELSE chain needed.
      set mv to read tin * 5000 / 1023
      set t10 to mv - 433
      set t10 to t10 * 100 / 300
      set t10 to t10 - 200
      IF mv > 733 THEN:
        set t10 to mv - 733
        set t10 to t10 * 100 / 413
        set t10 to t10 - 100
      IF mv > 1146 THEN:
        set t10 to mv - 1146
        set t10 to t10 * 100 / 511
      IF mv > 1657 THEN:
        set t10 to mv - 1657
        set t10 to t10 * 100 / 562
        set t10 to t10 + 100
      IF mv > 2219 THEN:
        set t10 to mv - 2219
        set t10 to t10 * 100 / 553
        set t10 to t10 + 200
      IF mv > 2772 THEN:
        set t10 to mv - 2772
        set t10 to t10 * 100 / 496
        set t10 to t10 + 300
      IF mv > 3268 THEN:
        set t10 to mv - 3268
        set t10 to t10 * 100 / 412
        set t10 to t10 + 400
      IF mv > 3680 THEN:
        set t10 to mv - 3680
        set t10 to t10 * 100 / 324
        set t10 to t10 + 500
      IF mv > 4004 THEN:
        set t10 to mv - 4004
        set t10 to t10 * 100 / 248
        set t10 to t10 + 600
      IF mv > 4252 THEN:
        set t10 to mv - 4252
        set t10 to t10 * 100 / 184
        set t10 to t10 + 700
      IF mv > 4436 THEN:
        set t10 to mv - 4436
        set t10 to t10 * 100 / 137
        set t10 to t10 + 800
      IF t10 < 0 THEN:
        # sub-zero: "-XY" whole degrees, minus glyph on the left digit
        set cand to 0 - t10
        set cand to cand / 10
        set showMinus to 1
        set dpDig to 9
      ELSE:
        set cand to t10
        set showMinus to 0
        set dpDig to 1
    IF cand > 999 THEN:
      set cand to 999
    # one count of hysteresis: the lit display loads the rails, the load
    # varies with the scan phase, and a boundary reading would flicker
    # its last digit forever - every real meter damps this
    set diff to cand - shown
    IF diff < 0 THEN:
      set diff to 0 - diff
    IF diff > 1 THEN:
      set shown to cand
      IF showMinus = 1 THEN:
        set d0 to 10
        set d1 to shown / 10
        set d2 to shown mod 10
      ELSE:
        set d0 to shown / 100
        set d1 to shown / 10 mod 10
        set d2 to shown mod 10
    wait 0.05 seconds
