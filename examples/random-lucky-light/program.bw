DEVICE STC12C5A60S2
CLOCK 11059200
PIN btn = P3.2 INPUT ACTIVE LOW
PIN led1 = P1.0 OUTPUT ACTIVE LOW
PIN led2 = P1.1 OUTPUT ACTIVE LOW
PIN led3 = P1.2 OUTPUT ACTIVE LOW
PIN led4 = P1.3 OUTPUT ACTIVE LOW

# Four lamps, one button. Every press lights one lamp chosen by chance --
# "pick random 1 to 4" -- after a short flicker through all of them. The
# green flag only puts every lamp out; the game itself starts by itself
# whenever the button goes down: a WHEN hat on a pin.
DEFINE show lamp:
  turn off led1
  turn off led2
  turn off led3
  turn off led4
  IF lamp = 1 THEN:
    turn on led1
  IF lamp = 2 THEN:
    turn on led2
  IF lamp = 3 THEN:
    turn on led3
  IF lamp = 4 THEN:
    turn on led4

WHEN flag clicked:
  set lamp to 0
  show lamp

WHEN btn pressed:
  REPEAT 8:
    set lamp to pick random 1 to 4
    show lamp
    wait 0.06 seconds
  set lamp to pick random 1 to 4
  show lamp
