DEVICE STC12C5A60S2
CLOCK 11059200
PIN din = P1.5 OUTPUT
PIN cs = P1.6 OUTPUT
PIN clk = P1.7 OUTPUT

GLOBAL column
GLOBAL command

# Shift an address/data command into the MAX7219, most significant bit first.
DEFINE write_command:
  set cs to 0
  REPEAT 16:
    IF (command bitand 32768) > 0 THEN:
      set din to 1
    ELSE:
      set din to 0
    set clk to 1
    set clk to 0
    set command to (command shiftleft 1) bitand 65535
  set cs to 1

STAGE:
  WHEN flag clicked:
    set clk to 0
    set cs to 1
    # Register 12, value 1, wakes the chip.
    set command to 3073
    write_command
    set column to 1
    FOREVER:
      set command to (column shiftleft 8) + 255
      write_command
      wait 0.2 seconds
      set command to column shiftleft 8
      write_command
      change column by 1
      IF column > 8 THEN:
        set column to 1
