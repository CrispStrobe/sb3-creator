# The full Ben Eater 6502 breadboard computer build.
# W65C02 + 62256 RAM + 28C256 ROM + W65C22 VIA + W65C51 ACIA
# + HD44780 LCD on VIA port B + PS/2 keyboard interface on VIA port A
# + 555 timer as clock source. This smoke program uses the ACIA serial output;
# the ROM examples exercise the LCD and keyboard peripherals.
DEVICE EATER6502
CLOCK 1000000

WHEN flag clicked:
  set counter to 0
  FOREVER:
    set counter to ((counter + 1) mod 256)
    print counter
    wait 0.25 seconds
