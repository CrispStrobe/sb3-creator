# Ported from arduino-examples/examples/10.StarterKit_BasicKit/p11_CrystalBall, CC0
DEVICE ARDUINO-UNO
CLOCK 16000000
PIN tilt = D6 INPUT

WHEN flag clicked:
  FOREVER:
    IF read tilt THEN:
      set roll to pick random 1 to 8
      IF roll = 1 THEN:
        print "Yes"
      IF roll = 2 THEN:
        print "Most likely"
      IF roll = 3 THEN:
        print "Certainly"
      IF roll = 4 THEN:
        print "Ask again"
      IF roll = 5 THEN:
        print "Without a doubt"
      IF roll = 6 THEN:
        print "Better not tell you"
      IF roll = 7 THEN:
        print "No"
      IF roll = 8 THEN:
        print "Signs point to yes"
      wait 1 seconds
    wait 0.1 seconds
