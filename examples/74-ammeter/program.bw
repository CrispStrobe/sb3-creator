# An ammeter the way real ones work: the current flows through a small
# SHUNT resistor (10 ohms here), the ADC measures the voltage across
# it, and Ohm's law gives the current: I = V / R. The potentiometer is
# the variable load - drag it and watch the milliamps change on the
# I2C character LCD.
DEVICE ARDUINO-NANO
CLOCK 16000000
PIN sda = A4 OUTPUT
PIN scl = A5 OUTPUT
PIN shunt = A0 ANALOG

STAGE:
  WHEN flag clicked:
    FOREVER:
      # One millivolt across the 10-ohm shunt is one tenth of a milliamp.
      set tenths to floor of ((read shunt * 5000 + 511) / 1023)
      set digit to tenths mod 10
      set whole to (tenths - digit) / 10
      lcd clear 1
      lcd set cursor 0 0 on 1
      lcd print "AMMETER" on 1
      lcd set cursor 1 0 on 1
      lcd print (whole) on 1
      lcd print "." on 1
      lcd print (digit) on 1
      lcd print " mA" on 1
      wait 0.2 seconds
