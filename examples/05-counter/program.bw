DEVICE STC12C5A60S2
CLOCK 11059200
PIN button = P3.2 INPUT ACTIVE LOW
PIN led1 = P1.0 OUTPUT ACTIVE LOW

# Count button presses, blink LED that many times
WHEN flag clicked:
  set count to 0
  FOREVER:
    wait until read button
    change count by 1
    IF count > 9 THEN:
      set count to 0
    REPEAT count:
      turn on led1
      wait 0.2 seconds
      turn off led1
      wait 0.2 seconds
    wait 0.5 seconds
