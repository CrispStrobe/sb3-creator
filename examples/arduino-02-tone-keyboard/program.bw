# Ported from arduino-examples/examples/02.Digital/toneKeyboard/toneKeyboard.ino, CC0
DEVICE ARDUINO-UNO
CLOCK 16000000
PIN sensor1 = A0 ANALOG
PIN sensor2 = A1 ANALOG
PIN speaker = D8 TONE

SPRITE Cat:
  WHEN flag clicked:
    forever:
      if read sensor1 > 10 then:
        set speaker to 440 hz
      else:
        if read sensor2 > 10 then:
          set speaker to 494 hz
        else:
          set speaker to 0 hz
      wait 0.05 seconds
