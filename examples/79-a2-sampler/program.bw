DEVICE STC89C52RC:
  CLOCK 11059200

  # Two peripherals that can honestly run together: the 4x4 keypad on P1
  # (measured rows P1.7-P1.4, cols P1.3-P1.0) and the 8-digit 7-seg display
  # behind the 74HC245/74HC138 pair (segments P0, select P2.2-P2.4).
  # The LED row is intentionally absent: it shares all of P2, including the
  # display select pins, and cannot hold an independent pattern while the
  # 74HC138 is being multiplexed.
  PART keys = KEYPAD4X4 ROWS P1.7 P1.6 P1.5 P1.4 COLS P1.3 P1.2 P1.1 P1.0
  PART display = SEVENSEG8 SEGMENTS P0 SELECT P2.2 P2.3 P2.4

  WHEN started:
    show number 0 on display
    FOREVER:
      IF a key is pressed THEN:
        show number keys on display
      wait 30 ms

  WHEN key 12 pressed:
    clear display
    show number 0 on display

  WHEN key 14 pressed:
    set hash_seen to 1
