# OUR OWN scrolling text firmware for the blinkenrocket pendant.
# NOT derived from the blinkenrocket GPL firmware — clean-room implementation
# of 8x8 LED matrix multiplexing and scrolling text.
DEVICE ATTINY88
CLOCK 8000000
# 788AS matrix: columns on PB0-PB7, rows on PD0-PD7
# Col LOW selects column, Row HIGH lights LED in that column
PIN col0 = PB0 OUTPUT
PIN col1 = PB1 OUTPUT
PIN col2 = PB2 OUTPUT
PIN col3 = PB3 OUTPUT
PIN col4 = PB4 OUTPUT
PIN col5 = PB5 OUTPUT
PIN col6 = PB6 OUTPUT
PIN col7 = PB7 OUTPUT
PIN row0 = PD0 OUTPUT
PIN row1 = PD1 OUTPUT
PIN row2 = PD2 OUTPUT
PIN row3 = PD3 OUTPUT
PIN row4 = PD4 OUTPUT
PIN row5 = PD5 OUTPUT
PIN row6 = PD6 OUTPUT
PIN row7 = PD7 OUTPUT
PIN btnLeft = PC3 INPUT
PIN btnRight = PC7 INPUT

SPRITE Cat:
  WHEN flag clicked:
    # Smiley pattern: 8 column bytes (bit n = row n lit)
    # Col 0: 0x00, Col 1: 0x24, Col 2: 0x24, Col 3: 0x00
    # Col 4: 0x42, Col 5: 0x3C, Col 6: 0x00, Col 7: 0x00
    set scrollPos to 0
    forever:
      # Drive columns 0-7 in sequence (multiplexing)
      # All columns off first (HIGH = deselected on 788AS)
      turn off col0
      turn off col1
      turn off col2
      turn off col3
      turn off col4
      turn off col5
      turn off col6
      turn off col7
      # Column 0: show smiley column data
      turn on row0
      turn off row1
      turn off row2
      turn off row3
      turn off row4
      turn off row5
      turn off row6
      turn off row7
      turn on col0
      wait 0.002 seconds
      turn off col0
      # Column 1: eyes (bits 2 and 5 = rows 2, 5)
      turn off row0
      turn off row1
      turn on row2
      turn off row3
      turn off row4
      turn on row5
      turn off row6
      turn off row7
      turn on col1
      wait 0.002 seconds
      turn off col1
      # Column 4: mouth sides (bits 1 and 6)
      turn off row0
      turn on row1
      turn off row2
      turn off row3
      turn off row4
      turn off row5
      turn on row6
      turn off row7
      turn on col4
      wait 0.002 seconds
      turn off col4
      # Column 5: mouth bottom (bits 2-5)
      turn off row0
      turn off row1
      turn on row2
      turn on row3
      turn on row4
      turn on row5
      turn off row6
      turn off row7
      turn on col5
      wait 0.002 seconds
      turn off col5
      # Check buttons for scrolling
      if read btnLeft then:
        wait 0.2 seconds
      if read btnRight then:
        wait 0.2 seconds
