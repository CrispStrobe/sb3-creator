# OUR OWN scrolling text firmware for the blinkenrocket pendant.
# NOT derived from the blinkenrocket GPL firmware.
DEVICE ATTINY88
CLOCK 8000000
PIN col0 = PB0 OUTPUT
PIN col1 = PB1 OUTPUT
PIN col2 = PB2 OUTPUT
PIN col3 = PB3 OUTPUT
PIN col4 = PB4 OUTPUT
PIN col5 = PB5 OUTPUT
PIN col6 = PB6 OUTPUT
PIN col7 = PB7 OUTPUT
PIN row0 = PD0 OUTPUT
PIN row1 = PD1 OUTPUT
PIN row2 = PD2 OUTPUT
PIN row3 = PD3 OUTPUT
PIN row4 = PD4 OUTPUT
PIN row5 = PD5 OUTPUT
PIN row6 = PD6 OUTPUT
PIN row7 = PD7 OUTPUT
PIN btnLeft = PC3 INPUT
PIN btnRight = PC7 INPUT

WHEN flag clicked:
  FOREVER:
    turn off col0
    turn off col1
    turn off col2
    turn off col3
    turn off col4
    turn off col5
    turn off col6
    turn off col7
    turn on row2
    turn on row5
    turn on col1
    wait 0.002 seconds
    turn off col1
    turn off row2
    turn off row5
    turn on row1
    turn on row6
    turn on col4
    wait 0.002 seconds
    turn off col4
    turn off row1
    turn off row6
    turn on row2
    turn on row3
    turn on row4
    turn on row5
    turn on col5
    wait 0.002 seconds
    turn off col5
    turn off row2
    turn off row3
    turn off row4
    turn off row5
    IF read btnLeft THEN:
      wait 0.2 seconds
    IF read btnRight THEN:
      wait 0.2 seconds
