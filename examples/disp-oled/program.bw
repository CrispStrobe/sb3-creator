DEVICE STC12C5A60S2
CLOCK 11059200
PIN sda = P2.1 OUTPUT
PIN scl = P2.2 OUTPUT

GLOBAL count

STAGE:
  # SSD1306 128×64 OLED showcase: print, cursor, pixel, clear.
  WHEN flag clicked:
    oled clear 1
    oled print "OLED DEMO" on 1
    oled set cursor 0 2 on 1
    oled print "Brickwright" on 1
    set count to 0
    FOREVER:
      oled set cursor 0 4 on 1
      oled print "Count: " on 1
      oled print count on 1
      oled print "  " on 1
      change count by 1
      wait 0.5 seconds
