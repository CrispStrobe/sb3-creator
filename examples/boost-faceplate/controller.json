{
  "version": 1,
  "mode": "play",
  "widgets": [
    {
      "name": "led",
      "type": "rgb_light",
      "config": { "r": 0, "g": 0, "b": 0 },
      "layout": { "x": 0, "y": 0 },
      "binding": { "target": "variable", "variableName": "hub_led" }
    },
    {
      "name": "power",
      "type": "slider",
      "config": { "min": 0, "max": 100, "step": 5, "value": 0 },
      "layout": { "x": 1, "y": 0 },
      "binding": { "target": "variable", "variableName": "motor_power" }
    },
    {
      "name": "go",
      "type": "button",
      "config": { "toggle": true, "label": "GO" },
      "layout": { "x": 0, "y": 1 },
      "binding": { "target": "variable", "variableName": "motor_run" }
    },
    {
      "name": "dir",
      "type": "button",
      "config": { "toggle": true, "label": "FWD/REV" },
      "layout": { "x": 1, "y": 1 },
      "binding": { "target": "variable", "variableName": "motor_dir" }
    }
  ]
}
