DEVICE STC12C5A60S2
CLOCK 11059200
PIN ldr = P1.7 ANALOG
PIN led1 = P1.0 OUTPUT ACTIVE LOW
PIN led2 = P1.1 OUTPUT ACTIVE LOW
PIN led3 = P1.2 OUTPUT ACTIVE LOW

# LDR brightness drives a 3-LED bar graph
WHEN flag clicked:
  FOREVER:
    IF read ldr > 256 THEN:
      turn on led1
    ELSE:
      turn off led1
    IF read ldr > 512 THEN:
      turn on led2
    ELSE:
      turn off led2
    IF read ldr > 768 THEN:
      turn on led3
    ELSE:
      turn off led3
    wait 0.1 seconds
