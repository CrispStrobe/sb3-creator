DEVICE STC12C5A60S2
CLOCK 11059200
PIN led0 = P2.0 OUTPUT ACTIVE LOW
PIN led1 = P2.1 OUTPUT ACTIVE LOW
PIN led2 = P2.2 OUTPUT ACTIVE LOW
PIN led3 = P2.3 OUTPUT ACTIVE LOW
PIN led4 = P2.4 OUTPUT ACTIVE LOW
PIN led5 = P2.5 OUTPUT ACTIVE LOW
PIN led6 = P2.6 OUTPUT ACTIVE LOW
PIN led7 = P2.7 OUTPUT ACTIVE LOW
PIN pot = P1.3 ANALOG

GLOBAL level

STAGE:
  # LED bargraph showcase: 8-LED level meter driven by a pot.
  WHEN flag clicked:
    # The package anodes connect to VCC on every variant. A low cathode lights a segment.
    FOREVER:
      set level to read pot / 128
      set led0 to 1
      set led1 to 1
      set led2 to 1
      set led3 to 1
      set led4 to 1
      set led5 to 1
      set led6 to 1
      set led7 to 1
      IF level > 0 THEN:
        set led0 to 0
      IF level > 1 THEN:
        set led1 to 0
      IF level > 2 THEN:
        set led2 to 0
      IF level > 3 THEN:
        set led3 to 0
      IF level > 4 THEN:
        set led4 to 0
      IF level > 5 THEN:
        set led5 to 0
      IF level > 6 THEN:
        set led6 to 0
      IF level > 7 THEN:
        set led7 to 0
      wait 0.1 seconds
