DEVICE STC12C5A60S2
CLOCK 11059200
PIN led0 = P2.0 OUTPUT ACTIVE LOW
PIN led1 = P2.1 OUTPUT ACTIVE LOW
PIN led2 = P2.2 OUTPUT ACTIVE LOW
PIN led3 = P2.3 OUTPUT ACTIVE LOW
PIN led4 = P2.4 OUTPUT ACTIVE LOW
PIN led5 = P2.5 OUTPUT ACTIVE LOW
PIN led6 = P2.6 OUTPUT ACTIVE LOW
PIN led7 = P2.7 OUTPUT ACTIVE LOW
PIN pot = P1.3 ANALOG

GLOBAL level

STAGE:
  # LED bargraph showcase: 8-LED level meter driven by a pot.
  WHEN flag clicked:
    FOREVER:
      set level to read pot / 128
      turn off led0
      turn off led1
      turn off led2
      turn off led3
      turn off led4
      turn off led5
      turn off led6
      turn off led7
      IF level > 0 THEN:
        turn on led0
      IF level > 1 THEN:
        turn on led1
      IF level > 2 THEN:
        turn on led2
      IF level > 3 THEN:
        turn on led3
      IF level > 4 THEN:
        turn on led4
      IF level > 5 THEN:
        turn on led5
      IF level > 6 THEN:
        turn on led6
      IF level > 7 THEN:
        turn on led7
      wait 0.1 seconds
