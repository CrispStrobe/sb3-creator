      turn off bus7
      turn on bus0
      turn on bus1
      turn on bus2
      turn on bus3
      turn on bus4
      turn on bus5
      turn on bus6
      turn on bus7
      turn on lcol1
      wait 0.004 seconds
      turn off lcol1
      turn off bus0
      turn off bus1
      turn off bus2
      turn off bus3
      turn off bus4
      turn off bus5
      turn off bus6
      turn off bus7
      turn on bus0
      turn on bus1
      turn on bus2
      turn on bus3
      turn on bus4
      turn on bus5
      turn on bus6
      turn on bus7
      turn on lcol2
      wait 0.004 seconds
      turn off lcol2
      turn off bus0
      turn off bus1
      turn off bus2
      turn off bus3
      turn off bus4
      turn off bus5
      turn off bus6
      turn off bus7
      turn on bus0
      turn on bus1
