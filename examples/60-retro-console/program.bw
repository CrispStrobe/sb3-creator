# The RBS15667 retro console, simulated: OUR OWN self-test firmware.
# Clean-room — game rules and vendor firmware are not involved; this
# program sweeps a bar down both matrix halves, walks 8 across the
# three score digits, and beeps while any button is held. The SAME
# hex flashes onto the real kit: make PART=stc15f2k60s2 flash.
# Pin map: docs/RETRO-CONSOLE-RBS15667.md (stc repo). Column order
# within each matrix is provisional until continuity-tested on the
# physical board.
DEVICE STC15F2K60S2
CLOCK 11059200
PIN bus0 = P1.5 OUTPUT
PIN bus1 = P4.1 OUTPUT
PIN bus2 = P2.4 OUTPUT
PIN bus3 = P2.2 OUTPUT
PIN bus4 = P2.1 OUTPUT
PIN bus5 = P2.0 OUTPUT
PIN bus6 = P4.4 OUTPUT
PIN bus7 = P1.4 OUTPUT
PIN ucol0 = P4.5 OUTPUT
PIN ucol1 = P2.7 OUTPUT
PIN ucol2 = P2.6 OUTPUT
PIN ucol3 = P0.0 OUTPUT
PIN ucol4 = P0.1 OUTPUT
PIN ucol5 = P0.2 OUTPUT
PIN ucol6 = P0.3 OUTPUT
PIN ucol7 = P0.4 OUTPUT
PIN lcol0 = P0.7 OUTPUT
PIN lcol1 = P0.6 OUTPUT
PIN lcol2 = P0.5 OUTPUT
PIN lcol3 = P1.0 OUTPUT
PIN lcol4 = P1.1 OUTPUT
PIN lcol5 = P1.6 OUTPUT
PIN lcol6 = P1.2 OUTPUT
PIN lcol7 = P1.3 OUTPUT
PIN dig1 = P2.3 OUTPUT ACTIVE LOW
PIN dig2 = P2.5 OUTPUT ACTIVE LOW
PIN dig3 = P4.2 OUTPUT ACTIVE LOW
PIN btn1 = P3.0 INPUT ACTIVE LOW
PIN btn2 = P3.2 INPUT ACTIVE LOW
PIN btn3 = P3.3 INPUT ACTIVE LOW
PIN btn4 = P3.7 INPUT ACTIVE LOW
PIN btn5 = P3.6 INPUT ACTIVE LOW
PIN buzzer = P5.5 OUTPUT ACTIVE LOW

WHEN flag clicked:
  # Inactive digit commons and PNP buzzer drive are high.
  set dig1 to 1
  set dig2 to 1
  set dig3 to 1
  set buzzer to 1
  # All eight rows use the same pattern during the bar sweep.
  set bus0 to 1
  set bus1 to 1
  set bus2 to 1
  set bus3 to 1
  set bus4 to 1
  set bus5 to 1
  set bus6 to 1
  FOREVER:
    set bus7 to 1
    REPEAT 2:
      set ucol0 to 1
      wait 0.008 seconds
      set ucol0 to 0
      set ucol1 to 1
      wait 0.008 seconds
      set ucol1 to 0
      set ucol2 to 1
      wait 0.008 seconds
      set ucol2 to 0
      set ucol3 to 1
      wait 0.008 seconds
      set ucol3 to 0
      set ucol4 to 1
      wait 0.008 seconds
      set ucol4 to 0
      set ucol5 to 1
      wait 0.008 seconds
      set ucol5 to 0
      set ucol6 to 1
      wait 0.008 seconds
      set ucol6 to 0
      set ucol7 to 1
      wait 0.008 seconds
      set ucol7 to 0
      set lcol0 to 1
      wait 0.008 seconds
      set lcol0 to 0
      set lcol1 to 1
      wait 0.008 seconds
      set lcol1 to 0
      set lcol2 to 1
      wait 0.008 seconds
      set lcol2 to 0
      set lcol3 to 1
      wait 0.008 seconds
      set lcol3 to 0
      set lcol4 to 1
      wait 0.008 seconds
      set lcol4 to 0
      set lcol5 to 1
      wait 0.008 seconds
      set lcol5 to 0
      set lcol6 to 1
      wait 0.008 seconds
      set lcol6 to 0
      set lcol7 to 1
      wait 0.008 seconds
      set lcol7 to 0
    # Keep the seven segments high and turn off the decimal point.
    set bus7 to 0
    set dig1 to 0
    wait 0.15 seconds
    set dig1 to 1
    set dig2 to 0
    wait 0.15 seconds
    set dig2 to 1
    set dig3 to 0
    wait 0.15 seconds
    set dig3 to 1
    IF read btn1 OR read btn2 OR read btn3 OR read btn4 OR read btn5 THEN:
      set buzzer to 0
    wait 0.05 seconds
    set buzzer to 1
