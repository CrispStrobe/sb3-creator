      turn off bus7
    # walk an 8 across the three score digits (segments = the bus)
    turn on dig1
    turn on bus0
    turn on bus1
    turn on bus2
    turn on bus3
    turn on bus4
    turn on bus5
    turn on bus6
    wait 0.15 seconds
    turn off bus0
    turn off bus1
    turn off bus2
    turn off bus3
    turn off bus4
    turn off bus5
    turn off bus6
    turn off dig1
    turn on dig2
    turn on bus0
    turn on bus1
    turn on bus2
    turn on bus3
    turn on bus4
    turn on bus5
    turn on bus6
    wait 0.15 seconds
    turn off bus0
    turn off bus1
    turn off bus2
    turn off bus3
    turn off bus4
    turn off bus5
    turn off bus6
    turn off dig2
    turn on dig3
    turn on bus0
    turn on bus1
    turn on bus2
    turn on bus3
    turn on bus4
    turn on bus5
    turn on bus6
    wait 0.15 seconds
    turn off bus0
    turn off bus1
    turn off bus2
    turn off bus3
    turn off bus4
    turn off bus5
    turn off bus6
    turn off dig3
    # any button held: beep
    IF read btn1 THEN:
      turn on buzzer
    IF read btn2 THEN:
      turn on buzzer
    IF read btn3 THEN:
      turn on buzzer
    IF read btn4 THEN:
      turn on buzzer
    IF read btn5 THEN:
      turn on buzzer
    wait 0.05 seconds
    turn off buzzer
