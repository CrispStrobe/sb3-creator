DEVICE STC12C5A60S2
CLOCK 11059200
PIN seg_a = P1.0 OUTPUT
PIN seg_b = P1.1 OUTPUT
PIN seg_c = P1.2 OUTPUT
PIN seg_d = P1.3 OUTPUT
PIN seg_e = P1.4 OUTPUT
PIN seg_f = P1.5 OUTPUT
PIN seg_g = P1.6 OUTPUT

TABLE font = 63, 6, 91, 79, 102, 109, 125, 7, 127, 111

GLOBAL digit

STAGE:
  # 7-segment display showcase: count 0–9.
  WHEN flag clicked:
    set digit to 0
    FOREVER:
      set segments to font[digit]
      set seg_a to segments bitand 1
      set seg_b to (segments shiftright 1) bitand 1
      set seg_c to (segments shiftright 2) bitand 1
      set seg_d to (segments shiftright 3) bitand 1
      set seg_e to (segments shiftright 4) bitand 1
      set seg_f to (segments shiftright 5) bitand 1
      set seg_g to (segments shiftright 6) bitand 1
      change digit by 1
      IF digit > 9 THEN:
        set digit to 0
      wait 1 seconds
