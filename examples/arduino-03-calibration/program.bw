# Ported from arduino-examples/examples/03.Analog/Calibration/Calibration.ino, CC0
DEVICE ARDUINO-UNO
CLOCK 16000000
PIN sensor = A0 ANALOG
PIN led = D9 PWM
PIN statusLed = D13 OUTPUT

SPRITE Cat:
  WHEN flag clicked:
    set sensorMin to 1023
    set sensorMax to 0
    turn on statusLed
    # Calibrate for 5 seconds
    repeat 100:
      set sensorValue to read sensor
      if sensorValue > sensorMax then:
        set sensorMax to sensorValue
      if sensorValue < sensorMin then:
        set sensorMin to sensorValue
      wait 0.05 seconds
    turn off statusLed
    # The filter, sized so its cost can be STATED rather than guessed.
    # Four samples, written as an explicit shift register rather than with a
    # list: the device C emitter has no lists, so the list form used in
    # arduino-03-smoothing lowers to comments and a constant 0 — a filter that
    # is present in the simulator and absent on the chip. This one lowers to
    # four `long` assignments and behaves the same in both.
    # The loop below runs every 20 ms, so this window takes
    # 4 x 20 ms = 80 ms to follow a step all the way, and lags a steady ramp
    # by (4 - 1) / 2 x 20 ms = 30 ms. Shorten the window and the light is
    # twitchier and sooner; lengthen it and it is calmer and later.
    set sample1 to 0
    set sample2 to 0
    set sample3 to 0
    set sample4 to 0
    # Main loop: average the raw reading, then map the calibrated range to the LED
    forever:
      set sample4 to sample3
      set sample3 to sample2
      set sample2 to sample1
      set sample1 to read sensor
      set sensorValue to (((sample1 + sample2) + (sample3 + sample4)) / 4)
      if sensorValue < sensorMin then:
        set sensorValue to sensorMin
      if sensorValue > sensorMax then:
        set sensorValue to sensorMax
      set outputValue to (((sensorValue - sensorMin) * 100) / (sensorMax - sensorMin))
      set led to outputValue percent
      wait 0.02 seconds
