DEVICE STC12C5A60S2
CLOCK 11059200
PIN led1 = P1.0 OUTPUT ACTIVE LOW

# Software PWM LED fade-in then fade-out
WHEN flag clicked:
  FOREVER:
    set duty to 0
    REPEAT 100:
      set i to 0
      REPEAT duty:
        turn on led1
        wait 0.001 seconds
      set i to 0
      REPEAT 100 - duty:
        turn off led1
        wait 0.001 seconds
      change duty by 1
    set duty to 100
    REPEAT 100:
      set i to 0
      REPEAT duty:
        turn on led1
        wait 0.001 seconds
      set i to 0
      REPEAT 100 - duty:
        turn off led1
        wait 0.001 seconds
      change duty by -1
