# Ported from arduino-examples/examples/10.StarterKit_BasicKit/p10_Zoetrope, CC0
DEVICE ARDUINO-UNO
CLOCK 16000000
PIN pot = A0 ANALOG
PIN btnFwd = D2 INPUT ACTIVE LOW
PIN btnRev = D3 INPUT ACTIVE LOW
PIN motorEnable = D9 PWM
PIN motorDir1 = D4 OUTPUT
PIN motorDir2 = D5 OUTPUT

SPRITE Cat:
  WHEN flag clicked:
    forever:
      set motorSpeed to ((read pot * 100) / 1023)
      if read btnFwd then:
        set motorDir1 to 1
        set motorDir2 to 0
        set motorEnable to motorSpeed percent
      if read btnRev then:
        set motorDir1 to 0
        set motorDir2 to 1
        set motorEnable to motorSpeed percent
      if not read btnFwd and not read btnRev then:
        set motorDir1 to 0
        set motorDir2 to 0
        set motorEnable to 0 percent
      wait 0.02 seconds
