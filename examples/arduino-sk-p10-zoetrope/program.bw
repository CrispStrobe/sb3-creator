# Ported from arduino-examples/examples/10.StarterKit_BasicKit/p10_Zoetrope, CC0
DEVICE ARDUINO-UNO
CLOCK 16000000
PIN pot = A0 ANALOG
PIN btnFwd = D2 INPUT
PIN btnRev = D3 INPUT
PIN motorEnable = D9 OUTPUT
PIN motorDir1 = D4 OUTPUT
PIN motorDir2 = D5 OUTPUT

SPRITE Cat:
  WHEN flag clicked:
    forever:
      set motorSpeed to ((read pot * 255) / 1023)
      if read btnFwd then:
        turn on motorDir1
        turn off motorDir2
        set pwm motorEnable to motorSpeed
      if read btnRev then:
        turn off motorDir1
        turn on motorDir2
        set pwm motorEnable to motorSpeed
      if not read btnFwd and not read btnRev then:
        turn off motorDir1
        turn off motorDir2
        turn off motorEnable
      wait 0.02 seconds
